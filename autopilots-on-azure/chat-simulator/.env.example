# Copy to .env and replace the three placeholders with your new registration.
# UUID values must use canonical lowercase spelling.
ENV=development
TSIM_AUTH_MODE=entra
TSIM_TENANT_ID=<your-directory-tenant-id>
TSIM_CLIENT_ID=<your-spa-and-api-application-client-id>
TSIM_SCOPE=api://<your-spa-and-api-application-client-id>/access_as_user
TSIM_REDIRECT_URI=http://localhost:5173/
TSIM_ALLOWED_ORIGINS=http://localhost:5173
TSIM_TEST_IDP=0

# Optional authenticated agent channel; leave unconfigured for people-only use.
TSIM_CHANNEL_CLIENT_ID=
TSIM_CHANNEL_CLIENT_SECRET=
TSIM_CHANNEL_MANAGED_IDENTITY_CLIENT_ID=
TSIM_SERVICE_URL=http://127.0.0.1:8000

# Declarative registration: choose one source; never commit live demo keys.
TSIM_AGENTS_JSON=
TSIM_AGENTS_FILE=

# Demo is never enabled by default. Generate an access code and a UTC expiry
# (future, maximum 30 days), and explicitly switch TSIM_AUTH_MODE to demo.
TSIM_DEMO_ACCESS_CODE=
TSIM_DEMO_EXPIRES_AT=
TSIM_DEMO_ACKNOWLEDGE=
